rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos live under farms/{farmId}/... — same access model as the data.
    match /farms/{farmId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 6 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
